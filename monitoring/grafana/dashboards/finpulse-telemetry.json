  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "FinPulse HTTP Request Throughput (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(finpulse_http_requests_total[1m])) by (method, status)",
          "legendFormat": "{{method}} - {{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "API Request Duration (p95 & p99 Latency)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(finpulse_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(finpulse_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Active Registered Portfolios",
      "type": "stat",
      "targets": [
        {
          "expr": "finpulse_active_portfolios",
          "legendFormat": "Portfolios"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Active Price Alert Rules",
      "type": "stat",
      "targets": [
        {
          "expr": "finpulse_active_alerts_total",
          "legendFormat": "Alert Rules"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
